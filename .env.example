# Copy to .env and fill in. .env is gitignored.

# The Google Sheet to sync from / write back to.
SHEET_ID=1MVY0sbANUKl1KrZ0cshNyHyQCT-54JwTw63r5O2eSEU

# Path to the service-account key JSON (gitignored, never commit it).
GOOGLE_APPLICATION_CREDENTIALS=server/credentials.json

# n8n Production "Webhook" URL the server sync POSTs to when new Red students appear.
# (Workflow must be Activated. This is the /webhook/ path, not /webhook-test/.)
N8N_WEBHOOK_URL=https://nishutsuman.app.n8n.cloud/webhook/sst-at-risk

# API port (the UI proxies /api here, n8n pulls from here).
PORT=8787
